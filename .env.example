NODE_ENV=development

# URL situs ini sendiri (metadataBase / sitemap / robots)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root backend, TANPA /api. Base API = ${NEXT_PUBLIC_BACKEND_URL}/api
NEXT_PUBLIC_BACKEND_URL=https://hmif-backend-v3.vercel.app

NEXT_PUBLIC_BASEPATH=/home

# openssl rand -base64 32
AUTH_SECRET_KEY=

# Cloudinary unsigned upload preset (Settings > Upload > Upload presets > Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
